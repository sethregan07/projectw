{
  "version": 3,
  "pages404": true,
  "caseSensitive": false,
  "basePath": "",
  "redirects": [
    {
      "source": "/:path+/",
      "destination": "/:path+",
      "internal": true,
      "statusCode": 308,
      "regex": "^(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))/$"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: https:; font-src 'self' data:;"
        }
      ],
      "regex": "^(?:/(.*))(?:/)?$"
    }
  ],
  "rewrites": {
    "beforeFiles": [],
    "afterFiles": [
      {
        "source": "/api/auth/:path*",
        "destination": "http://api-gateway:3000/api/auth/:path*",
        "regex": "^/api/auth(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/api/users/:path*",
        "destination": "http://api-gateway:3000/api/users/:path*",
        "regex": "^/api/users(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/api/newsletter/:path*",
        "destination": "http://api-gateway:3000/api/newsletter/:path*",
        "regex": "^/api/newsletter(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      },
      {
        "source": "/api/v1/ghost/:path*",
        "destination": "http://ghost-service:2368/ghost/api/v4/:path*",
        "regex": "^/api/v1/ghost(?:/((?:[^/]+?)(?:/(?:[^/]+?))*))?(?:/)?$"
      }
    ],
    "fallback": []
  },
  "dynamicRoutes": [
    {
      "page": "/api/proposals/[id]",
      "regex": "^/api/proposals/([^/]+?)(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/proposals/(?<nxtPid>[^/]+?)(?:/)?$"
    },
    {
      "page": "/api/proposals/[id]/vote",
      "regex": "^/api/proposals/([^/]+?)/vote(?:/)?$",
      "routeKeys": {
        "nxtPid": "nxtPid"
      },
      "namedRegex": "^/api/proposals/(?<nxtPid>[^/]+?)/vote(?:/)?$"
    },
    {
      "page": "/articles/[slug]",
